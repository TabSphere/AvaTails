# AvaTails — environment variables
# Copy to .env.local for local dev. On Vercel: Project Settings -> Environment Variables.

# --- OpenAI (scripts + scene illustrations) — REQUIRED ---
OPENAI_API_KEY=sk-...
# Optional overrides:
# OPENAI_SCRIPT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1        # set to dall-e-3 if your org is not verified for gpt-image-1

# --- ElevenLabs (voiceover) — REQUIRED ---
ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel (warm, friendly)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Vercel Blob (persistence: history, asset storage, music) — RECOMMENDED ---
# Set automatically when you attach a Blob store to the project (Storage tab in Vercel).
# Without it everything still works; videos are returned as instant downloads only.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Password gate — RECOMMENDED ---
# When set, the dashboard and all APIs require this password (login page).
# FACTORY_PASSWORD=choose-something-strong

# --- Local dev only: point at system ffmpeg if the bundled binary can't execute ---
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# --- Cron security — REQUIRED on Vercel ---
# Vercel cron sends this as a Bearer token; without it anyone could trigger the queue worker.
# Generate a long random string and set the same value in Vercel env vars.
CRON_SECRET=your-long-random-secret-here
