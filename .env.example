# AvaTails — environment variables
# Copy this file to .env.local for local development.
# On Vercel: Project Settings -> Environment Variables.

# --- OpenAI (scripts + scene illustrations) ---
OPENAI_API_KEY=sk-...
# Optional overrides:
# OPENAI_SCRIPT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1        # set to dall-e-3 if your org is not verified for gpt-image-1

# --- ElevenLabs (voiceover) ---
ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # default: Rachel (warm, friendly)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
